{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intent Compiler Clarification",
  "type": "object",
  "required": ["question", "reason", "options"],
  "properties": {
    "question": {"type": "string"},
    "reason": {"type": "string"},
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": {"type": "string"},
          "value": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
